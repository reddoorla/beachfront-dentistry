# Prismic environment (optional — falls back to slicemachine.config.json repositoryName)
VITE_PRISMIC_ENVIRONMENT=

# Fleet forms: forward contact submissions to the central dashboard ingest
# endpoint. Set BOTH on the deployed site (plural names). The token is the SAME
# value as the dashboard's FORMS_INGEST_TOKEN; the URL ends in this site's slug
# (derived from the Airtable Websites `Name`, e.g. .../api/forms/acme).
FORMS_INGEST_URL=https://reddoor-maintenance.netlify.app/api/forms/<slug>
FORMS_INGEST_TOKEN=replace-with-the-shared-forms-ingest-token

# Cloudflare Turnstile (optional contact-form anti-bot). Public site key — safe to
# expose in HTML. Leave unset to keep the widget off (honeypot + fill-timing still
# apply). Verification runs centrally in the dashboard, which holds the secret, so a
# site needs only this public key. Create a widget at dash.cloudflare.com → Turnstile
# and add the site's apex + www hostnames.
PUBLIC_TURNSTILE_SITE_KEY=

# Google Maps JavaScript API key for the contact-page map (blux/maps-loader.ts
# loads `maps.googleapis.com/maps/api/js?key=`). The `VITE_` prefix is REQUIRED —
# Vite only exposes prefixed vars to client code, and this is read client-side as
# `import.meta.env.VITE_GOOGLE_MAPS_KEY`. A var named GOOGLE_MAPS_API_KEY is
# silently invisible to the app and the map renders blank.
#
# Like every VITE_ var this is inlined into the client bundle, so it is public by
# design — that is normal for Maps JS keys, and the real control is the key's
# restrictions, not secrecy. In Google Cloud Console set:
#   Application restrictions -> HTTP referrers: the production hostnames PLUS
#     http://localhost:5173/* and the Netlify preview domain, or the map is blank
#     in dev and on previews (RefererNotAllowedMapError).
#   API restrictions -> Maps JavaScript API (NOT Maps Embed API — different
#     product; restricting to it breaks the map).
VITE_GOOGLE_MAPS_KEY=
