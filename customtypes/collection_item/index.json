{
  "id": "collection_item",
  "label": "Collection Item",
  "format": "custom",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "uid"
        }
      },
      "title": {
        "type": "StructuredText",
        "config": {
          "label": "title",
          "single": "heading1"
        }
      },
      "body": {
        "type": "StructuredText",
        "config": {
          "label": "body",
          "multi": "paragraph,strong,em,hyperlink,list-item,o-list-item"
        }
      },
      "link_label": {
        "type": "Text",
        "config": {
          "label": "link label (category-panel wording — falls back to title)"
        }
      },
      "order": {
        "type": "Number",
        "config": {
          "label": "order within its category panel (lowest first)"
        }
      },
      "media": {
        "type": "Image",
        "config": {
          "label": "media",
          "constraint": {},
          "thumbnails": []
        }
      },
      "gallery": {
        "type": "Group",
        "config": {
          "label": "gallery",
          "fields": {
            "image": {
              "type": "Image",
              "config": {
                "label": "image",
                "constraint": {},
                "thumbnails": []
              }
            },
            "caption": {
              "type": "Text",
              "config": {
                "label": "caption"
              }
            }
          }
        }
      },
      "tags": {
        "type": "Text",
        "config": {
          "label": "tags (comma-separated)"
        }
      },
      "date": {
        "type": "Date",
        "config": {
          "label": "date"
        }
      },
      "link": {
        "type": "Link",
        "config": {
          "label": "link",
          "allowTargetBlank": true,
          "select": null
        }
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "type": "Text",
        "config": {
          "label": "Meta Title",
          "placeholder": "A title for search engines and social media. The site adds \"Beachfront Dentistry | \" in front; keep the whole thing ≤ 70 characters. Empty = the page title."
        }
      },
      "meta_description": {
        "type": "Text",
        "config": {
          "label": "Meta Description",
          "placeholder": "A brief summary of the page. Empty = the start of the body. Meta Image empty = the main image (media)."
        }
      },
      "meta_image": {
        "type": "Image",
        "config": {
          "label": "Meta Image",
          "constraint": {
            "width": 2400,
            "height": 1260
          },
          "thumbnails": []
        }
      }
    }
  }
}
