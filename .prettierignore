pnpm-lock.yaml
.svelte-kit/
build/
.netlify/
dist/
# Machine-generated by `blux convert` — not hand-authored, so its JSON.stringify
# array formatting shouldn't be style-linted (up to ~550 product entries).
src/lib/blux/products.json

# Frozen-page artifacts emitted by `blux freeze` — a byte-faithful copy of the
# Blux export's own markup (whitespace between inline elements is layout-
# significant, so prettier must NOT reflow it) plus its extracted stylesheet and
# slot manifest.
**/*.frozen.html
src/routes/dev/blux-frozen/the-pointe.html
src/routes/dev/blux-frozen/the-pointe.style.css
src/routes/dev/blux-frozen/the-pointe.slots.json
frozen/

# Internal planning artifacts (brainstorming specs + implementation plans), not
# shipped source — kept verbatim, so they aren't style-linted.
docs/superpowers/

# Matching harness — recipe-owned CODE only. These files are the source the
# `match-harness` recipe is cut from and are re-installed byte-for-byte across
# sites whose printWidth differs from this repo's; formatting them per site
# would make every future upgrade read as a hand edit. harness.json keeps its
# hand-chosen row layout for the same reason — it is a table, not prose, and
# prettier would otherwise reflow three of its nine anchor rows. Everything
# else under matching/ (SPEC.md, LEDGER.md, spec-sections/, states/*.mjs)
# stays inside `prettier --check .`; eslint already ignores this whole
# directory (eslint.config.js:52), so that is the only style check the records
# have.
matching/*.mjs
matching/*.sh
matching/harness.json
